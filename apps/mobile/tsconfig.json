{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // I test girano su node, non su React Native: hanno il loro programma
  // (test/tsconfig.json) con i tipi di node, che qui non devono entrare.
  "exclude": ["node_modules", "ios", "android", "test"]
}
